# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real credentials.

# "sandbox" or "production". Sandbox is the default and should stay the
# active environment until you're ready to go live with real eBay data.
EBAY_ENV=sandbox

# eBay Developer Sandbox keyset (from developer.ebay.com -> My Account -> Application Keys)
EBAY_SANDBOX_CLIENT_ID=
EBAY_SANDBOX_CLIENT_SECRET=

# eBay Production keyset — leave blank until you're ready to switch EBAY_ENV=production
EBAY_PRODUCTION_CLIENT_ID=
EBAY_PRODUCTION_CLIENT_SECRET=

# eBay marketplace to search (EBAY_US, EBAY_GB, EBAY_CA, etc.)
EBAY_MARKETPLACE_ID=EBAY_US

# Upstash Redis (https://upstash.com, free tier) — optional. Leave both
# blank for local development (the want list is stored in a local file
# instead). Set both once you host this somewhere, so the want list
# survives redeploys/restarts instead of resetting to the seeded books.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local server port
PORT=3000
